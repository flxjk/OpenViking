{
  "name": "@openviking/sdk",
  "version": "1.0.0",
  "description": "Effect 4.1 TypeScript SDK for OpenViking — full API coverage, typed errors, streaming, retries and a self-improving retrieval loop",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volcengine/OpenViking.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./generated": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js",
      "require": "./dist/generated/index.cjs"
    }
  },
  "files": ["dist", "README.md", "README_CN.md"],
  "scripts": {
    "generate": "python3 scripts/generate.py && python3 scripts/probe_responses.py",
    "generate:mutations": "python3 scripts/probe_mutations.py && python3 scripts/generate.py",
    "build": "tsup src/index.ts src/generated/index.ts --format esm,cjs --dts --clean",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "peerDependencies": {
    "effect": "^4.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "effect": "4.1.3",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
